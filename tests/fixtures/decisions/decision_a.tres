[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/data/decision_data.gd" id="1_decision"]
[ext_resource type="Script" path="res://scripts/data/choice_data.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/data/condition_data.gd" id="3_condition"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="4_effect"]

[sub_resource type="Resource" id="Condition_a_1"]
script = ExtResource("3_condition")
kind = &"resource"
resource_id = "res_a"
comparison = &"ge"
value = 1

[sub_resource type="Resource" id="Effect_a_1"]
script = ExtResource("4_effect")
kind = &"resource_spend"
resource_id = "res_a"
amount = 1

[sub_resource type="Resource" id="Effect_a_2"]
script = ExtResource("4_effect")
kind = &"flag_set"
flag_id = "flag_a"
flag_value = true

[sub_resource type="Resource" id="Condition_b_1"]
script = ExtResource("3_condition")
kind = &"trust"
source_actor_id = "actor_a"
target_actor_id = "actor_b"
comparison = &"ge"
value = 50

[sub_resource type="Resource" id="Effect_b_1"]
script = ExtResource("4_effect")
kind = &"trust_change"
source_actor_id = "actor_a"
target_actor_id = "actor_b"
amount = -5

[sub_resource type="Resource" id="Choice_a"]
script = ExtResource("2_choice")
id = "choice_a"
conditions = Array[ExtResource("3_condition")]([SubResource("Condition_a_1")])
effects = Array[ExtResource("4_effect")]([SubResource("Effect_a_1"), SubResource("Effect_a_2")])
action_id = "action_a"

[sub_resource type="Resource" id="Choice_b"]
script = ExtResource("2_choice")
id = "choice_b"
conditions = Array[ExtResource("3_condition")]([SubResource("Condition_b_1")])
effects = Array[ExtResource("4_effect")]([SubResource("Effect_b_1")])

[resource]
script = ExtResource("1_decision")
id = "decision_a"
choices = Array[ExtResource("2_choice")]([SubResource("Choice_a"), SubResource("Choice_b")])
